.prob-card {
  padding: 22rpx;
  background-color: #F7FAF9;
  border: 2rpx solid rgba(227, 232, 239, 0.84);
  border-radius: var(--radius-md);
}

.prob-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 14rpx;
  margin-bottom: 18rpx;
}

.prob-school {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.school-name {
  font-size: 28rpx;
  line-height: 1.45;
  font-weight: 700;
  color: var(--color-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.school-code {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.prob-stats {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.prob-bar-wrap {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.prob-bar-bg {
  flex: 1;
  height: 18rpx;
  background-color: #E5EBF0;
  border-radius: 999rpx;
  overflow: hidden;
}

.prob-bar-fill {
  height: 100%;
  border-radius: 999rpx;
  transition: width 0.6s ease;
}

.prob-value {
  font-size: 27rpx;
  color: var(--color-text-primary);
  font-weight: 760;
  min-width: 76rpx;
  text-align: right;
}

.score-diff {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.45;
}
