.gradient-section {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 20rpx;
  border-radius: var(--radius-md);
  background-color: #F7FAF9;
  border: 2rpx solid rgba(227, 232, 239, 0.84);
}

.gradient-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.gradient-label {
  width: 76rpx;
  font-size: 26rpx;
  color: var(--color-text-regular);
  font-weight: 650;
}

.gradient-bar {
  flex: 1;
  height: 20rpx;
  background-color: #E5EBF0;
  border-radius: 999rpx;
  overflow: hidden;
}

.gradient-fill {
  height: 100%;
  border-radius: 999rpx;
  transition: width 0.6s ease;
}

.reach {
  background-color: var(--color-danger);
}

.target {
  background-color: var(--color-warning);
}

.safety {
  background-color: var(--color-success);
}

.gradient-count {
  width: 74rpx;
  text-align: right;
  font-size: 25rpx;
  color: var(--color-text-secondary);
}
