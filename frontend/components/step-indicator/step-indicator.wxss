.steps {
  display: flex;
  align-items: flex-start;
  justify-content: center;
  padding: 26rpx 22rpx;
  background-color: #FFFFFF;
  border: 2rpx solid rgba(227, 232, 239, 0.92);
  border-radius: var(--radius-lg);
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-card);
}

.step-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  flex: 1;
  min-width: 0;
}

.step-circle {
  width: 54rpx;
  height: 54rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 25rpx;
  font-weight: 700;
  color: var(--color-text-secondary);
  background-color: #F1F4F7;
  border: 2rpx solid var(--color-border);
  margin-bottom: 12rpx;
  z-index: 1;
}

.step-active .step-circle {
  color: #FFFFFF;
  background-color: var(--color-primary);
  border-color: var(--color-primary);
}

.step-completed .step-circle {
  color: var(--color-primary);
  background-color: var(--color-primary-soft);
  border-color: rgba(31, 122, 104, 0.26);
}

.step-check {
  font-size: 26rpx;
  font-weight: 800;
}

.step-title {
  max-width: 160rpx;
  font-size: 23rpx;
  line-height: 1.35;
  color: var(--color-text-secondary);
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.step-active .step-title {
  color: var(--color-primary);
  font-weight: 700;
}

.step-completed .step-title {
  color: var(--color-text-regular);
  font-weight: 600;
}

.step-line {
  position: absolute;
  top: 27rpx;
  left: calc(50% + 36rpx);
  right: calc(-50% + 36rpx);
  height: 4rpx;
  border-radius: 999rpx;
  background-color: var(--color-border);
}

.step-line-active {
  background-color: rgba(31, 122, 104, 0.42);
}
