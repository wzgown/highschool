.tip-section {
  margin-top: 28rpx;
  padding-bottom: 12rpx;
}

.tip-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  min-height: 72rpx;
  padding: 0 20rpx;
  border-radius: var(--radius-md);
  background-color: #FFFFFF;
  border: 2rpx solid var(--color-border);
}

.tip-toggle:active {
  background-color: #F7FAF9;
}

.tip-label {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  font-weight: 600;
}

.tip-arrow {
  font-size: 30rpx;
  color: var(--color-text-secondary);
  transition: transform 0.2s;
}

.tip-arrow.expanded {
  transform: rotate(90deg);
}

.tip-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0 32rpx;
}

.tip-qr {
  width: 320rpx;
  border-radius: var(--radius-md);
  border: 2rpx solid var(--color-border);
}

.tip-hint {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  margin-top: 12rpx;
}
