.recommendation-hero {
  padding-bottom: 20rpx;
}

.step-content {
  animation: fade-in 0.22s ease;
}

@keyframes fade-in {
  from {
    opacity: 0;
    transform: translateY(12rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.checkbox-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 60rpx;
}

.checkbox-label {
  font-size: 28rpx;
  color: var(--color-text-primary);
  font-weight: 600;
}

.score-card {
  padding: 0;
  overflow: hidden;
}

.score-card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 28rpx;
  background-color: #F7FAF9;
  border-bottom: 2rpx solid rgba(227, 232, 239, 0.86);
}

.score-title-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-width: 0;
}

.score-max-hint {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.score-body {
  padding: 26rpx 28rpx 8rpx;
}

.score-empty {
  padding: 44rpx 28rpx;
  text-align: center;
}

.score-empty-text {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.conversion-hint {
  margin: 0 0 20rpx;
  padding: 16rpx 20rpx;
  border-radius: var(--radius-md);
  font-size: 26rpx;
  line-height: 1.5;
  font-weight: 600;
}

.conversion-hint-primary {
  background-color: var(--color-primary-soft);
  color: var(--color-primary);
}

.conversion-hint-success {
  background-color: var(--color-success-soft);
  color: var(--color-success);
}

.loading-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 6rpx solid var(--color-border);
  border-top-color: var(--color-primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.loading-text {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: var(--color-primary);
  font-weight: 600;
}

.result-tabs {
  display: flex;
  gap: 8rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
  border-radius: var(--radius-md);
  background-color: #EAF0F4;
}

.result-tab {
  flex: 1;
  min-height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-sm);
  font-size: 27rpx;
  color: var(--color-text-secondary);
  font-weight: 650;
}

.result-tab.active {
  background-color: #FFFFFF;
  color: var(--color-primary);
  box-shadow: 0 6rpx 18rpx rgba(23, 32, 42, 0.08);
}

.conversion-card {
  padding-bottom: 26rpx;
}

.conversion-grid {
  display: flex;
  gap: 14rpx;
}

.conversion-item {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 18rpx 10rpx;
  border-radius: var(--radius-md);
  background-color: #F7FAF9;
}

.conversion-label {
  font-size: 23rpx;
  color: var(--color-text-secondary);
}

.conversion-value {
  font-size: 28rpx;
  line-height: 1.35;
  font-weight: 700;
  color: var(--color-text-primary);
  white-space: nowrap;
}

.rec-card {
  padding-bottom: 26rpx;
}

.rec-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.rec-item {
  padding: 22rpx;
  border-radius: var(--radius-md);
  background-color: #F7FAF9;
  border: 2rpx solid rgba(227, 232, 239, 0.84);
}

.rec-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 14rpx;
  margin-bottom: 16rpx;
}

.rec-school {
  flex: 1;
  min-width: 0;
  font-size: 29rpx;
  line-height: 1.45;
  font-weight: 700;
  color: var(--color-text-primary);
}

.rec-metrics {
  display: flex;
  gap: 14rpx;
  margin-bottom: 10rpx;
}

.rec-metric {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  padding: 14rpx 16rpx;
  border-radius: var(--radius-sm);
  background-color: #FFFFFF;
}

.rec-metric-label {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.rec-metric-value {
  font-size: 26rpx;
  color: var(--color-text-primary);
  font-weight: 700;
}

.rec-reason {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.55;
  padding-top: 12rpx;
  border-top: 2rpx solid rgba(227, 232, 239, 0.9);
}

.empty-card {
  padding: 48rpx 24rpx;
}

.empty-text {
  display: block;
  text-align: center;
  font-size: 28rpx;
  color: var(--color-text-secondary);
}
