<template name="rec-section">
  <view wx:if="{{results.quotaDistrictRecommendations.length > 0}}" class="card rec-card">
    <view class="card-header">
      <view class="card-header-icon"></view>
      <text>名额分配到区</text>
      <text class="tag tag-info">{{results.quotaDistrictRecommendations.length}} 所</text>
    </view>
    <view class="rec-list">
      <view wx:for="{{results.quotaDistrictRecommendations}}" wx:key="schoolId" class="rec-item">
        <view class="rec-header">
          <text class="rec-school">{{item.schoolName}}</text>
          <text class="tag tag-{{item.typeTag}}">{{item.typeText}}</text>
        </view>
        <view class="rec-metrics">
          <view class="rec-metric">
            <text class="rec-metric-label">预估线</text>
            <text class="rec-metric-value">{{item.estimatedScore}} 分</text>
          </view>
          <view class="rec-metric">
            <text class="rec-metric-label">分差</text>
            <text class="rec-metric-value">{{item.scoreGap}} 分</text>
          </view>
        </view>
        <text wx:if="{{item.recommendationReason}}" class="rec-reason">{{item.recommendationReason}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{results.quotaSchoolRecommendations.length > 0}}" class="card rec-card">
    <view class="card-header">
      <view class="card-header-icon"></view>
      <text>名额分配到校</text>
      <text class="tag tag-info">{{results.quotaSchoolRecommendations.length}} 所</text>
    </view>
    <view class="rec-list">
      <view wx:for="{{results.quotaSchoolRecommendations}}" wx:key="schoolId" class="rec-item">
        <view class="rec-header">
          <text class="rec-school">{{item.schoolName}}</text>
          <text class="tag tag-{{item.typeTag}}">{{item.typeText}}</text>
        </view>
        <view class="rec-metrics">
          <view class="rec-metric">
            <text class="rec-metric-label">预估线</text>
            <text class="rec-metric-value">{{item.estimatedScore}} 分</text>
          </view>
          <view class="rec-metric">
            <text class="rec-metric-label">分差</text>
            <text class="rec-metric-value">{{item.scoreGap}} 分</text>
          </view>
        </view>
        <text wx:if="{{item.recommendationReason}}" class="rec-reason">{{item.recommendationReason}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{results.unifiedRecommendations.length > 0}}" class="card rec-card">
    <view class="card-header">
      <view class="card-header-icon"></view>
      <text>统一招生</text>
      <text class="tag tag-info">{{results.unifiedRecommendations.length}} 所</text>
    </view>
    <view class="rec-list">
      <view wx:for="{{results.unifiedRecommendations}}" wx:key="schoolId" class="rec-item">
        <view class="rec-header">
          <text class="rec-school">{{item.schoolName}}</text>
          <text class="tag tag-{{item.typeTag}}">{{item.typeText}}</text>
        </view>
        <view class="rec-metrics">
          <view class="rec-metric">
            <text class="rec-metric-label">预估线</text>
            <text class="rec-metric-value">{{item.estimatedScore}} 分</text>
          </view>
          <view class="rec-metric">
            <text class="rec-metric-label">分差</text>
            <text class="rec-metric-value">{{item.scoreGap}} 分</text>
          </view>
        </view>
        <text wx:if="{{item.recommendationReason}}" class="rec-reason">{{item.recommendationReason}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{results.quotaDistrictRecommendations.length === 0 && results.quotaSchoolRecommendations.length === 0 && results.unifiedRecommendations.length === 0}}" class="card empty-card">
    <text class="empty-text">暂无推荐结果</text>
  </view>
</template>

<view class="container recommendation-page">
  <view class="page-hero recommendation-hero">
    <text class="page-eyebrow">智能推荐</text>
    <text class="page-title">冲稳保志愿参考</text>
    <text class="page-subtitle">根据模考分数和所在区，生成可继续模拟的志愿候选清单。</text>
  </view>

  <step-indicator
    steps="{{['基本信息', '模考成绩', '推荐结果']}}"
    current="{{currentStep}}"
  />

  <view wx:if="{{currentStep === 0}}" class="step-content">
    <view class="card">
      <view class="card-header">
        <view class="card-header-icon"></view>
        <text>考生基本信息</text>
      </view>

      <view class="form-group">
        <view class="form-label">
          <text class="form-required">*</text>
          <text>所属区县</text>
        </view>
        <view class="form-picker" bindtap="onDistrictPickerOpen">
          <text class="{{districtName ? 'form-picker-value' : 'form-picker-placeholder'}}">
            {{districtName || '请选择所属区县'}}
          </text>
          <text class="form-picker-arrow">›</text>
        </view>
      </view>

      <view class="form-group">
        <view class="form-label">
          <text>初中学校</text>
        </view>
        <view class="form-picker {{!districtId ? 'form-input-disabled' : ''}}" bindtap="onMiddleSchoolPickerOpen">
          <text class="{{middleSchoolName ? 'form-picker-value' : 'form-picker-placeholder'}}">
            {{middleSchoolName || '请先选择区县（选填）'}}
          </text>
          <text class="form-picker-arrow">›</text>
        </view>
        <text class="form-tip">选填，用于名额到校推荐。</text>
      </view>

      <view class="form-group">
        <view class="checkbox-row">
          <switch checked="{{hasQuotaSchoolEligibility}}" bindchange="onQuotaEligibilityChange" color="#1F7A68" />
          <text class="checkbox-label">具备名额分配到校填报资格</text>
        </view>
        <text class="form-tip">关闭后不生成名额到校推荐。</text>
      </view>
    </view>
  </view>

  <view wx:if="{{currentStep === 1}}" class="step-content">
    <view class="alert alert-info">一模、二模至少填写一项；系统会换算为 750 分制。</view>

    <view class="card score-card">
      <view class="score-card-header">
        <view class="score-title-row">
          <text class="tag tag-primary">一模</text>
          <text class="score-max-hint">{{districtName}}总分：{{firstMockMax}}分</text>
        </view>
        <switch checked="{{firstMockHasScore}}" bindchange="onFirstMockToggle" color="#1F7A68" />
      </view>

      <view wx:if="{{firstMockHasScore}}" class="score-body">
        <view class="form-group">
          <view class="form-label"><text>一模总分</text></view>
          <input class="form-input" type="digit" placeholder="请输入总分" value="{{firstMockTotalScore || ''}}" bindinput="onFirstMockScoreInput" maxlength="4" />
        </view>
        <view class="form-group">
          <view class="form-label"><text>区排名（选填）</text></view>
          <input class="form-input" type="number" placeholder="请输入区排名" value="{{firstMockDistrictRank || ''}}" bindinput="onFirstMockRankInput" maxlength="5" />
        </view>
        <view wx:if="{{firstMockConverted}}" class="conversion-hint conversion-hint-primary">
          预估中考等效：约 {{firstMockConverted}} 分
        </view>
      </view>
      <view wx:else class="score-empty">
        <text class="score-empty-text">未填写一模成绩</text>
      </view>
    </view>

    <view class="card score-card">
      <view class="score-card-header">
        <view class="score-title-row">
          <text class="tag tag-success">二模</text>
          <text class="score-max-hint">{{districtName}}总分：{{secondMockMax}}分</text>
        </view>
        <switch checked="{{secondMockHasScore}}" bindchange="onSecondMockToggle" color="#1F7A68" />
      </view>

      <view wx:if="{{secondMockHasScore}}" class="score-body">
        <view class="form-group">
          <view class="form-label"><text>二模总分</text></view>
          <input class="form-input" type="digit" placeholder="请输入总分" value="{{secondMockTotalScore || ''}}" bindinput="onSecondMockScoreInput" maxlength="4" />
        </view>
        <view class="form-group">
          <view class="form-label"><text>区排名（选填）</text></view>
          <input class="form-input" type="number" placeholder="请输入区排名" value="{{secondMockDistrictRank || ''}}" bindinput="onSecondMockRankInput" maxlength="5" />
        </view>
        <view wx:if="{{secondMockConverted}}" class="conversion-hint conversion-hint-success">
          预估中考等效：约 {{secondMockConverted}} 分
        </view>
      </view>
      <view wx:else class="score-empty">
        <text class="score-empty-text">未填写二模成绩</text>
      </view>
    </view>
  </view>

  <view wx:if="{{currentStep === 2}}" class="step-content">
    <view wx:if="{{loading}}" class="loading-box">
      <view class="loading-spinner"></view>
      <text class="loading-text">正在生成智能推荐...</text>
    </view>

    <view wx:elif="{{firstMockResults || secondMockResults}}">
      <view wx:if="{{firstMockResults && secondMockResults}}" class="result-tabs">
        <view class="result-tab {{activeResultTab === 'firstMock' ? 'active' : ''}}" bindtap="onTabChange" data-tab="firstMock">
          <text>一模推荐</text>
        </view>
        <view class="result-tab {{activeResultTab === 'secondMock' ? 'active' : ''}}" bindtap="onTabChange" data-tab="secondMock">
          <text>二模推荐</text>
        </view>
      </view>

      <view wx:if="{{activeResultTab === 'firstMock' && firstMockResults}}">
        <view wx:if="{{firstMockResults.scoreConversion}}" class="card conversion-card">
          <view class="card-header">
            <view class="card-header-icon"></view>
            <text>分数转换</text>
          </view>
          <view class="conversion-grid">
            <view class="conversion-item">
              <text class="conversion-label">原始分数</text>
              <text class="conversion-value">{{firstMockResults.scoreConversion.originalScore}} 分</text>
            </view>
            <view class="conversion-item">
              <text class="conversion-label">750分制</text>
              <text class="conversion-value text-primary">{{firstMockResults.scoreConversion.convertedScore750}} 分</text>
            </view>
            <view class="conversion-item">
              <text class="conversion-label">800分制</text>
              <text class="conversion-value text-success">{{firstMockResults.scoreConversion.convertedScore800}} 分</text>
            </view>
          </view>
        </view>

        <template is="rec-section" data="{{results: firstMockResults}}" />
      </view>

      <view wx:if="{{activeResultTab === 'secondMock' && secondMockResults}}">
        <view wx:if="{{secondMockResults.scoreConversion}}" class="card conversion-card">
          <view class="card-header">
            <view class="card-header-icon"></view>
            <text>分数转换</text>
          </view>
          <view class="conversion-grid">
            <view class="conversion-item">
              <text class="conversion-label">原始分数</text>
              <text class="conversion-value">{{secondMockResults.scoreConversion.originalScore}} 分</text>
            </view>
            <view class="conversion-item">
              <text class="conversion-label">750分制</text>
              <text class="conversion-value text-primary">{{secondMockResults.scoreConversion.convertedScore750}} 分</text>
            </view>
            <view class="conversion-item">
              <text class="conversion-label">800分制</text>
              <text class="conversion-value text-success">{{secondMockResults.scoreConversion.convertedScore800}} 分</text>
            </view>
          </view>
        </view>

        <template is="rec-section" data="{{results: secondMockResults}}" />
      </view>

      <view class="actions">
        <button class="btn-primary" bindtap="goToSimulation">去模拟填报</button>
        <button class="btn-secondary" bindtap="onReset">重新推荐</button>
      </view>

      <tip-section />
    </view>

    <view wx:else class="card empty-card">
      <text class="empty-text">暂无推荐结果，请先填写模考成绩</text>
    </view>
  </view>

  <view wx:if="{{showDistrictPicker}}" class="quick-picker-overlay" bindtap="onDistrictPickerClose">
    <view class="quick-picker-panel" catchtap="noop">
      <view class="quick-picker-header">
        <text class="quick-picker-title">选择所属区县</text>
        <view class="quick-picker-close" bindtap="onDistrictPickerClose">
          <text>×</text>
        </view>
      </view>
      <view class="quick-picker-search-wrap">
        <input
          class="quick-picker-search"
          placeholder="输入区名或拼音缩写，如 黄浦 / hp"
          value="{{districtSearch}}"
          bindinput="onDistrictSearch"
          confirm-type="search"
          focus="{{showDistrictPicker}}"
        />
      </view>
      <scroll-view class="quick-picker-list" scroll-y>
        <view
          wx:for="{{filteredDistricts}}"
          wx:key="id"
          class="quick-picker-item"
          bindtap="onDistrictSelect"
          data-id="{{item.id}}"
        >
          <text class="quick-picker-name">{{item.name}}</text>
          <text wx:if="{{item.code}}" class="quick-picker-code">{{item.code}}</text>
        </view>
        <view wx:if="{{filteredDistricts.length === 0}}" class="quick-picker-empty">
          <text>暂无匹配区县</text>
        </view>
      </scroll-view>
    </view>
  </view>

  <view wx:if="{{showMiddleSchoolPicker}}" class="quick-picker-overlay" bindtap="onMiddleSchoolPickerClose">
    <view class="quick-picker-panel" catchtap="noop">
      <view class="quick-picker-header">
        <text class="quick-picker-title">选择初中学校</text>
        <view class="quick-picker-close" bindtap="onMiddleSchoolPickerClose">
          <text>×</text>
        </view>
      </view>
      <view class="quick-picker-search-wrap">
        <input
          class="quick-picker-search"
          placeholder="输入学校名称或代码"
          value="{{middleSchoolSearch}}"
          bindinput="onMiddleSchoolSearch"
          confirm-type="search"
          focus="{{showMiddleSchoolPicker}}"
        />
      </view>
      <scroll-view class="quick-picker-list" scroll-y>
        <view
          wx:for="{{filteredMiddleSchools}}"
          wx:key="id"
          class="quick-picker-item"
          bindtap="onMiddleSchoolSelect"
          data-id="{{item.id}}"
        >
          <text class="quick-picker-name">{{item.name}}</text>
          <text wx:if="{{item.code}}" class="quick-picker-code">{{item.code}}</text>
        </view>
        <view wx:if="{{filteredMiddleSchools.length === 0}}" class="quick-picker-empty">
          <text>暂无匹配初中</text>
        </view>
      </scroll-view>
    </view>
  </view>

  <view wx:if="{{currentStep < 2}}" class="actions">
    <button wx:if="{{currentStep === 1}}" class="btn-secondary" bindtap="prevStep">上一步</button>
    <button wx:if="{{currentStep === 0}}" class="btn-primary {{canNext ? '' : 'btn-disabled'}}" bindtap="nextStep" disabled="{{!canNext}}">下一步</button>
    <button wx:if="{{currentStep === 1}}" class="btn-primary {{canSubmit ? '' : 'btn-disabled'}}" bindtap="onSubmit" disabled="{{!canSubmit || loading}}" loading="{{loading}}">获取推荐</button>
  </view>
</view>
