.form-hero {
  padding-bottom: 20rpx;
}

.form-card {
  padding: 30rpx;
}

.form-card .actions {
  padding-top: 8rpx;
}

.switch-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 60rpx;
}

.switch-label {
  font-size: 28rpx;
  color: var(--color-text-regular);
  font-weight: 600;
}

.score-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.score-item {
  width: calc(33.333% - 11rpx);
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.score-label {
  min-height: 34rpx;
  font-size: 23rpx;
  line-height: 1.4;
  color: var(--color-text-secondary);
  text-align: center;
}

.score-input {
  width: 100%;
  height: 76rpx;
  text-align: center;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-md);
  font-size: 28rpx;
  color: var(--color-text-primary);
  background-color: #FFFFFF;
}

.score-input:focus {
  border-color: rgba(31, 122, 104, 0.55);
}

.volunteer-section {
  padding: 26rpx 0 24rpx;
  border-top: 2rpx solid rgba(227, 232, 239, 0.84);
}

.volunteer-section:first-of-type {
  border-top: none;
  padding-top: 0;
}

.volunteer-section-last {
  padding-bottom: 0;
}

.section-subtitle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 18rpx;
}

.section-count {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  white-space: nowrap;
}

.volunteer-item {
  display: flex;
  align-items: center;
  height: 96rpx;
  padding: 0 14rpx;
  margin-bottom: 12rpx;
  background-color: #F7FAF9;
  border: 2rpx solid rgba(227, 232, 239, 0.84);
  border-radius: var(--radius-md);
  overflow: hidden;
  /* 避免长按时触发系统选中/放大，造成画面闪缩 */
  user-select: none;
  -webkit-user-select: none;
  -webkit-touch-callout: none;
}

.volunteer-item:active {
  border-color: rgba(31, 122, 104, 0.42);
  background-color: var(--color-primary-soft);
}

.volunteer-index-cell {
  width: 54rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.volunteer-index {
  width: 46rpx;
  height: 46rpx;
  line-height: 46rpx;
  border-radius: 50%;
  background-color: #FFFFFF;
  border: 2rpx solid rgba(31, 122, 104, 0.28);
  color: var(--color-primary);
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.volunteer-content {
  flex: 1;
  min-width: 0;
  height: 96rpx;
  display: flex;
  align-items: center;
  padding: 0 12rpx;
}

.volunteer-name,
.volunteer-placeholder {
  display: block;
  width: 100%;
  font-size: 28rpx;
  line-height: 1.2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.volunteer-name {
  color: var(--color-text-primary);
  font-weight: 600;
}

.volunteer-placeholder {
  color: var(--color-text-muted);
}

.volunteer-action {
  width: 58rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.volunteer-clear {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text-secondary);
  font-size: 34rpx;
  border-radius: 50%;
  background-color: #FFFFFF;
}

.volunteer-clear text {
  line-height: 1;
}

.volunteer-item.dragging {
  position: relative;
  z-index: 10;
  background-color: var(--color-primary-soft);
  border-color: rgba(31, 122, 104, 0.55);
}

.picker-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(23, 32, 42, 0.46);
  z-index: 999;
  display: flex;
  align-items: flex-end;
}

.picker-panel {
  width: 100%;
  max-height: 82vh;
  padding-bottom: env(safe-area-inset-bottom);
  background-color: #FFFFFF;
  border-radius: 24rpx 24rpx 0 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-shadow: var(--shadow-panel);
}

.picker-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx 20rpx;
}

.picker-title {
  font-size: 32rpx;
  line-height: 1.35;
  font-weight: 700;
  color: var(--color-text-primary);
}

.picker-close {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text-secondary);
  font-size: 36rpx;
  background-color: #F1F4F7;
}

.picker-search-wrap {
  padding: 0 32rpx 18rpx;
  border-bottom: 2rpx solid var(--color-border);
}

.picker-search {
  width: 100%;
  height: 76rpx;
  padding: 0 26rpx;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-md);
  font-size: 28rpx;
  color: var(--color-text-primary);
  background-color: #F7F9FB;
}

.picker-list {
  max-height: 62vh;
  padding: 0 32rpx;
  overflow-x: hidden;
}

.picker-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  min-height: 96rpx;
  padding: 22rpx 0;
  border-bottom: 2rpx solid rgba(227, 232, 239, 0.76);
}

.picker-item:active {
  background-color: #F7FAF9;
}

.picker-item:last-child {
  border-bottom: none;
}

.picker-item-info {
  flex: 1;
  min-width: 0;
}

.picker-item-name {
  display: block;
  font-size: 28rpx;
  line-height: 1.45;
  color: var(--color-text-primary);
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.picker-item-code {
  display: block;
  font-size: 23rpx;
  color: var(--color-text-secondary);
  margin-top: 4rpx;
}

.picker-item-quota {
  font-size: 23rpx;
  color: var(--color-primary);
  background-color: var(--color-primary-soft);
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}

.picker-empty {
  padding: 80rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

.form-picker-disabled {
  background-color: #F0F3F6;
  opacity: 0.72;
}

.step-summary {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx 18rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 28rpx;
  background-color: #F7FAF9;
  border: 2rpx solid rgba(227, 232, 239, 0.8);
  border-radius: var(--radius-md);
}

.step-summary-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  max-width: 100%;
  font-size: 24rpx;
  line-height: 1.4;
}

.step-summary-label {
  color: var(--color-text-secondary);
  white-space: nowrap;
}

.step-summary-value {
  color: var(--color-text-primary);
  font-weight: 650;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
