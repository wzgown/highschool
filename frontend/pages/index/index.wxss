.home-page {
  min-height: 100vh;
  padding-top: 28rpx;
  /* tab 页：为悬浮的 custom-tab-bar（100rpx + 安全区）预留底部空间 */
  padding-bottom: calc(100rpx + env(safe-area-inset-bottom));
}

.hero-band {
  padding: 40rpx 34rpx 34rpx;
  border-radius: 22rpx;
  background: #102A24;
  color: #FFFFFF;
  box-shadow: 0 18rpx 42rpx rgba(16, 42, 36, 0.22);
}

.hero-topline {
  display: flex;
  align-items: center;
  margin-bottom: 34rpx;
}

.hero-logo {
  width: 76rpx;
  height: 76rpx;
  margin-right: 18rpx;
  border-radius: 18rpx;
  background: #FFFFFF;
}

.hero-eyebrow {
  font-size: 25rpx;
  line-height: 1.35;
  color: #98DCCF;
  font-weight: 700;
}

.home-title {
  display: block;
  font-size: 64rpx;
  line-height: 1.08;
  font-weight: 800;
  color: #FFFFFF;
}

.home-subtitle {
  display: block;
  margin-top: 24rpx;
  font-size: 29rpx;
  line-height: 1.65;
  color: rgba(255, 255, 255, 0.78);
}

.hero-action {
  display: flex;
  align-items: center;
  margin-top: 42rpx;
  padding: 26rpx 28rpx;
  border-radius: 18rpx;
  background: #FFFFFF;
}

.hero-action:active,
.secondary-card:active {
  opacity: 0.82;
}

.hero-action-copy {
  flex: 1;
  min-width: 0;
}

.hero-action-title {
  display: block;
  font-size: 33rpx;
  line-height: 1.35;
  font-weight: 700;
  color: #17202A;
}

.hero-action-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.45;
  color: #7C8794;
}

.hero-action-arrow {
  width: 58rpx;
  height: 58rpx;
  line-height: 54rpx;
  margin-left: 18rpx;
  text-align: center;
  border-radius: 50%;
  color: #FFFFFF;
  background: #1F7A68;
  font-size: 42rpx;
  flex-shrink: 0;
}

.secondary-actions {
  display: flex;
  margin-top: 22rpx;
}

.secondary-card {
  position: relative;
  flex: 1;
  min-height: 224rpx;
  padding: 26rpx 22rpx;
  border-radius: 18rpx;
  background: #FFFFFF;
  border: 2rpx solid #E3E8EF;
  box-shadow: 0 12rpx 30rpx rgba(23, 32, 42, 0.06);
}

.secondary-card:first-child {
  margin-right: 18rpx;
}

.secondary-glyph {
  width: 64rpx;
  height: 64rpx;
  margin-bottom: 22rpx;
  border-radius: 18rpx;
  position: relative;
}

.recommend-glyph {
  background: #EEF2FA;
}

.history-glyph {
  background: #E8F3F0;
}

.glyph-node {
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  border: 6rpx solid #2D5BBA;
  position: absolute;
  left: 17rpx;
  top: 16rpx;
}

.glyph-node.small {
  width: 14rpx;
  height: 14rpx;
  left: 38rpx;
  top: 38rpx;
  border-width: 5rpx;
}

.glyph-line {
  width: 30rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #1F7A68;
  position: absolute;
  left: 17rpx;
  top: 22rpx;
}

.glyph-line.short {
  width: 20rpx;
  top: 38rpx;
}

.secondary-title {
  display: block;
  margin-bottom: 8rpx;
  font-size: 30rpx;
  line-height: 1.35;
  font-weight: 700;
  color: #17202A;
}

.secondary-desc {
  display: block;
  padding-right: 16rpx;
  font-size: 23rpx;
  line-height: 1.5;
  color: #7C8794;
}

.secondary-arrow {
  position: absolute;
  right: 22rpx;
  bottom: 20rpx;
  font-size: 36rpx;
  line-height: 1;
  color: #A6B0BB;
}

.disclaimer {
  padding: 42rpx 12rpx 10rpx;
  text-align: center;
}

.disclaimer-text {
  display: block;
  font-size: 22rpx;
  color: #7C8794;
  line-height: 1.55;
}

.about-link {
  display: inline-block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #1F7A68;
  font-weight: 700;
}
