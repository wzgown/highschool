<view class="container home-page">
  <view class="hero-band">
    <view class="hero-topline">
      <image class="hero-logo" src="/images/logo.png" mode="aspectFit" />
      <text class="hero-eyebrow">上海中考志愿模拟</text>
    </view>

    <text class="home-title">折桂登高</text>
    <text class="home-subtitle">围绕成绩、排名和志愿顺序，形成可复盘的录取概率分析。</text>

    <view class="hero-action" bindtap="onStartAnalysis">
      <view class="hero-action-copy">
        <text class="hero-action-title">开始志愿模拟</text>
        <text class="hero-action-desc">适合已有目标学校和志愿顺序</text>
      </view>
      <text class="hero-action-arrow">›</text>
    </view>
  </view>

  <view class="secondary-actions">
    <view class="secondary-card" bindtap="onSmartRecommend">
      <view class="secondary-glyph recommend-glyph">
        <view class="glyph-node"></view>
        <view class="glyph-node small"></view>
      </view>
      <text class="secondary-title">志愿推荐</text>
      <text class="secondary-desc">根据模考成绩生成冲稳保参考</text>
      <text class="secondary-arrow">›</text>
    </view>

    <view class="secondary-card" bindtap="onViewHistory">
      <view class="secondary-glyph history-glyph">
        <view class="glyph-line"></view>
        <view class="glyph-line short"></view>
      </view>
      <text class="secondary-title">历史分析</text>
      <text class="secondary-desc">对比之前提交的志愿方案</text>
      <text class="secondary-arrow">›</text>
    </view>
  </view>

  <view class="disclaimer">
    <text class="disclaimer-text">分析结果仅供参考，实际录取以官方公布结果为准。</text>
    <text class="about-link" bindtap="goAbout">关于数据与规则</text>
  </view>
</view>
