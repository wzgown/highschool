.history-hero {
  padding-bottom: 20rpx;
}

.loading-wrapper {
  min-height: 52vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 6rpx solid var(--color-border);
  border-top-color: var(--color-primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 24rpx;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.loading-text {
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

.history-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.history-count {
  font-size: 25rpx;
  color: var(--color-text-secondary);
}

.refresh-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-height: 60rpx;
  padding: 0 20rpx;
  background-color: #FFFFFF;
  border: 2rpx solid var(--color-border);
  border-radius: 999rpx;
}

.refresh-btn:active {
  background-color: var(--color-primary-soft);
}

.refresh-icon {
  font-size: 28rpx;
  color: var(--color-primary);
}

.refresh-text {
  font-size: 24rpx;
  color: var(--color-primary);
  font-weight: 650;
}

.history-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.history-card {
  padding: 28rpx;
  background-color: #FFFFFF;
  border: 2rpx solid rgba(227, 232, 239, 0.92);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
}

.card-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 22rpx;
}

.card-meta {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.card-time {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.35;
}

.card-district {
  font-size: 26rpx;
  color: var(--color-text-primary);
  line-height: 1.35;
  font-weight: 650;
}

.delete-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background-color: #F3F5F7;
  flex-shrink: 0;
}

.delete-btn:active {
  background-color: var(--color-danger-soft);
}

.delete-icon {
  font-size: 30rpx;
  line-height: 1;
  color: var(--color-danger);
}

.card-summary {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 22rpx;
}

.score-block {
  width: 128rpx;
  height: 96rpx;
  display: flex;
  align-items: baseline;
  justify-content: center;
  border-radius: var(--radius-md);
  background-color: var(--color-primary-soft);
  color: var(--color-primary);
  flex-shrink: 0;
  padding-top: 18rpx;
}

.score-value {
  font-size: 36rpx;
  line-height: 1;
  font-weight: 760;
}

.score-unit {
  margin-left: 4rpx;
  font-size: 22rpx;
}

.summary-copy {
  flex: 1;
  min-width: 0;
}

.summary-volunteers {
  display: block;
  font-size: 29rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  margin-bottom: 12rpx;
}

.summary-tags {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
}

.card-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding-top: 18rpx;
  border-top: 2rpx solid rgba(227, 232, 239, 0.86);
}

.detail-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  min-height: 52rpx;
}

.detail-text {
  font-size: 26rpx;
  color: var(--color-primary);
  font-weight: 650;
}

.detail-arrow {
  font-size: 32rpx;
  color: var(--color-primary);
  line-height: 1;
}
