<view class="container result-page">
  <block wx:if="{{loading}}">
    <loading-skeleton loading="{{true}}" title="分析进行中" hint="正在生成排名、概率和策略建议" rows="{{6}}"></loading-skeleton>
  </block>

  <block wx:elif="{{error}}">
    <view class="state-panel state-danger">
      <view class="state-mark">!</view>
      <text class="state-title">分析失败</text>
      <text class="state-desc">{{error}}</text>
      <view class="state-actions">
        <button class="btn-primary" bindtap="onRetry">重试</button>
        <button class="btn-secondary" bindtap="goBack">返回修改</button>
      </view>
    </view>
  </block>

  <block wx:elif="{{!loading && !error && !predictions && !probabilities.length}}">
    <view class="state-panel">
      <view class="state-mark">?</view>
      <text class="state-title">暂无分析结果</text>
      <text class="state-desc">未获取到有效的分析数据，请重新提交。</text>
      <button class="btn-primary state-button" bindtap="goBack">返回重新分析</button>
    </view>
  </block>

  <block wx:else>
    <view class="page-hero report-hero">
      <text class="page-eyebrow">分析报告</text>
      <text class="page-title">志愿分析报告</text>
      <text class="page-subtitle" wx:if="{{result.createdAt}}">生成时间：{{result.createdAt}}</text>
    </view>

    <view class="summary-grid">
      <view class="summary-card" wx:if="{{predictions}}">
        <text class="summary-label">区内排名预测</text>
        <view class="summary-value-row">
          <text class="summary-value">{{predictions.districtRank || '--'}}</text>
          <text class="summary-unit">名</text>
        </view>
        <text class="summary-caption" wx:if="{{predictions.rankLow || predictions.rankHigh}}">
          区间 {{predictions.rankLow || '?'}}-{{predictions.rankHigh || '?'}} 名
        </text>
      </view>

      <view class="summary-card" wx:if="{{strategy}}">
        <text class="summary-label">策略评分</text>
        <view class="summary-value-row">
          <text class="summary-value">{{strategy.score || '--'}}</text>
          <text class="summary-unit">分</text>
        </view>
        <text class="summary-caption">冲 {{strategy.reach || 0}} / 稳 {{strategy.target || 0}} / 保 {{strategy.safety || 0}}</text>
      </view>
    </view>

    <view class="card" wx:if="{{predictions && predictions.confidence}}">
      <view class="card-header">
        <view class="card-header-icon"></view>
        <text>排名可信度</text>
        <text class="tag tag-{{predictions.confidence === 'high' ? 'success' : predictions.confidence === 'medium' ? 'warning' : 'info'}}">
          {{predictions.confidence === 'high' ? '较高' : predictions.confidence === 'medium' ? '中等' : '偏低'}}
        </text>
      </view>
      <view class="confidence-copy">
        <text>排名预测会随当年试题难度、招生计划和同分段人数变化，请结合后续官方数据复核。</text>
      </view>
    </view>

    <view class="card" wx:if="{{probabilities.length}}">
      <view class="card-header">
        <view class="card-header-icon"></view>
        <text>录取概率</text>
        <text class="tag tag-info">{{probabilities.length}} 个志愿</text>
      </view>
      <view class="probability-list">
        <probability-card
          wx:for="{{probabilities}}"
          wx:key="index"
          batch="{{item.batch}}"
          batch-name="{{item.batchName}}"
          batch-type="{{item.batchType}}"
          school-name="{{item.schoolName}}"
          school-code="{{item.schoolCode}}"
          probability="{{item.probability}}"
          risk-level="{{item.riskLevel}}"
          risk-text="{{item.riskText}}"
          risk-type="{{item.riskType}}"
          score-diff="{{item.scoreDiff}}"
        ></probability-card>
      </view>
    </view>

    <view class="card" wx:if="{{strategy}}">
      <view class="card-header">
        <view class="card-header-icon"></view>
        <text>志愿策略</text>
        <text class="tag tag-{{strategy.score >= 80 ? 'success' : strategy.score >= 60 ? 'warning' : 'danger'}}" wx:if="{{strategy.score}}">
          {{strategy.score}}分
        </text>
      </view>

      <gradient-bar
        wx:if="{{strategy.reach || strategy.target || strategy.safety}}"
        reach="{{strategy.reach || 0}}"
        target="{{strategy.target || 0}}"
        safety="{{strategy.safety || 0}}"
      ></gradient-bar>

      <view class="insight-section" wx:if="{{strategy.suggestions.length}}">
        <text class="section-label">优化建议</text>
        <view class="insight-list">
          <view class="insight-item insight-success" wx:for="{{strategy.suggestions}}" wx:key="index">
            <text class="insight-mark">✓</text>
            <text class="insight-text">{{item}}</text>
          </view>
        </view>
      </view>

      <view class="insight-section" wx:if="{{strategy.warnings.length}}">
        <text class="section-label">风险提示</text>
        <view class="insight-list">
          <view class="insight-item insight-warning" wx:for="{{strategy.warnings}}" wx:key="index">
            <text class="insight-mark">!</text>
            <text class="insight-text">{{item}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="card" wx:if="{{competitors}}">
      <view class="card-header">
        <view class="card-header-icon"></view>
        <text>竞争态势</text>
      </view>
      <view class="competitor-summary">
        <text class="competitor-label">虚拟竞争对手</text>
        <text class="competitor-value">{{competitors.count}} 人</text>
      </view>

      <view class="distribution-chart" wx:if="{{competitors.distributions.length}}">
        <text class="section-label">分数分布</text>
        <view class="distribution-list">
          <view class="distribution-item" wx:for="{{competitors.distributions}}" wx:key="index">
            <text class="distribution-label">{{item.range}}分</text>
            <view class="distribution-bar-bg">
              <view class="distribution-bar-fill" style="width: {{item.percent}}%;"></view>
            </view>
            <text class="distribution-value">{{item.count}}人</text>
          </view>
        </view>
      </view>
    </view>

    <view class="result-actions">
      <button class="btn-secondary action-btn" bindtap="goBack">返回修改</button>
      <button class="btn-primary action-btn" bindtap="viewHistory">查看历史</button>
      <button class="btn-secondary action-btn" bindtap="askAgent" wx:if="{{agentEnabled}}">问问 AI 顾问</button>
    </view>

    <tip-section />
  </block>
</view>
