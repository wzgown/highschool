.report-hero {
  padding-bottom: 20rpx;
}

.state-panel {
  min-height: 70vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 36rpx;
  text-align: center;
}

.state-mark {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  background-color: var(--color-primary-soft);
  color: var(--color-primary);
  font-size: 40rpx;
  font-weight: 700;
}

.state-danger .state-mark {
  background-color: var(--color-danger-soft);
  color: var(--color-danger);
}

.state-title {
  display: block;
  font-size: 34rpx;
  line-height: 1.35;
  font-weight: 700;
  color: var(--color-text-primary);
  margin-bottom: 12rpx;
}

.state-desc {
  display: block;
  max-width: 560rpx;
  font-size: 27rpx;
  color: var(--color-text-secondary);
  line-height: 1.65;
  margin-bottom: 36rpx;
}

.state-actions {
  display: flex;
  gap: 20rpx;
  width: 100%;
}

.state-actions button {
  flex: 1;
}

.state-button {
  min-width: 280rpx;
}

.summary-grid {
  display: flex;
  gap: 18rpx;
  margin-bottom: 24rpx;
}

.summary-card {
  flex: 1;
  min-width: 0;
  padding: 26rpx 24rpx;
  border-radius: var(--radius-lg);
  background-color: #FFFFFF;
  border: 2rpx solid rgba(227, 232, 239, 0.92);
  box-shadow: var(--shadow-card);
}

.summary-label {
  display: block;
  font-size: 23rpx;
  line-height: 1.35;
  color: var(--color-text-secondary);
  margin-bottom: 12rpx;
}

.summary-value-row {
  display: flex;
  align-items: baseline;
  min-width: 0;
}

.summary-value {
  font-size: 54rpx;
  line-height: 1;
  font-weight: 780;
  color: var(--color-primary);
}

.summary-unit {
  margin-left: 6rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.summary-caption {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.4;
  color: var(--color-text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.confidence-copy {
  padding: 18rpx 20rpx;
  border-radius: var(--radius-md);
  background-color: #F7FAF9;
  color: var(--color-text-secondary);
  font-size: 25rpx;
  line-height: 1.65;
}

.probability-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.section-label {
  display: block;
  font-size: 27rpx;
  font-weight: 700;
  color: var(--color-text-regular);
  margin: 30rpx 0 16rpx;
}

.insight-section {
  display: flex;
  flex-direction: column;
}

.insight-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.insight-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 16rpx 18rpx;
  border-radius: var(--radius-md);
  border: 2rpx solid transparent;
}

.insight-success {
  background-color: var(--color-success-soft);
  border-color: rgba(36, 138, 90, 0.12);
}

.insight-warning {
  background-color: var(--color-warning-soft);
  border-color: rgba(201, 120, 24, 0.14);
}

.insight-mark {
  flex-shrink: 0;
  width: 34rpx;
  height: 34rpx;
  line-height: 34rpx;
  text-align: center;
  border-radius: 50%;
  background-color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.insight-warning .insight-mark {
  color: var(--color-warning);
}

.insight-text {
  flex: 1;
  min-width: 0;
  font-size: 25rpx;
  color: var(--color-text-regular);
  line-height: 1.65;
}

.competitor-summary {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 22rpx;
  background-color: #F7FAF9;
  border: 2rpx solid rgba(227, 232, 239, 0.8);
  border-radius: var(--radius-md);
}

.competitor-label {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.competitor-value {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.distribution-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.distribution-item {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.distribution-label {
  flex-shrink: 0;
  width: 118rpx;
  font-size: 23rpx;
  color: var(--color-text-secondary);
  text-align: right;
}

.distribution-bar-bg {
  flex: 1;
  height: 22rpx;
  background-color: #EEF2F6;
  border-radius: 999rpx;
  overflow: hidden;
}

.distribution-bar-fill {
  height: 100%;
  background-color: var(--color-secondary);
  border-radius: 999rpx;
  transition: width 0.3s ease;
}

.distribution-value {
  flex-shrink: 0;
  width: 72rpx;
  font-size: 23rpx;
  color: var(--color-text-regular);
}

.result-actions {
  display: flex;
  gap: 20rpx;
  padding: 8rpx 0 32rpx;
}

.action-btn {
  flex: 1;
}
