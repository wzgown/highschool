<view class="container about-page">
  <view class="about-hero">
    <image class="about-logo" src="/images/logo.png" mode="aspectFit" />
    <view class="about-copy">
      <text class="page-eyebrow">关于</text>
      <text class="about-title">折桂登高</text>
      <text class="about-desc">面向上海中考志愿填报的模拟分析工具。</text>
    </view>
  </view>

  <view class="card">
    <view class="card-header">
      <view class="card-header-icon"></view>
      <text>数据与边界</text>
    </view>
    <view class="info-list">
      <view class="info-row">
        <text class="info-label">数据来源</text>
        <text class="info-value">上海市教育考试院历年公开数据</text>
      </view>
      <view class="info-row">
        <text class="info-label">结果性质</text>
        <text class="info-value">仅供参考，不构成任何录取承诺</text>
      </view>
    </view>
  </view>

  <view class="card" wx:if="{{agentEnabled}}">
    <view class="card-header">
      <view class="card-header-icon"></view>
      <text>{{aiCardTitle}}</text>
    </view>
    <view class="info-list">
      <view class="info-row" wx:if="{{aiLines.length >= 1}}">
        <text class="info-label">{{aiLines[0].label}}</text>
        <text class="info-value">{{aiLines[0].value}}</text>
      </view>
      <view class="info-row" wx:if="{{aiLines.length >= 2}}">
        <text class="info-label">{{aiLines[1].label}}</text>
        <text class="info-value">{{aiLines[1].value}}</text>
      </view>
      <view class="info-row" wx:if="{{aiLines.length >= 3}}">
        <text class="info-label">{{aiLines[2].label}}</text>
        <text class="info-value">{{aiLines[2].value}}</text>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="card-header">
      <view class="card-header-icon"></view>
      <text>覆盖范围</text>
    </view>
    <view class="feature-list">
      <view class="feature-item">
        <text class="feature-index">01</text>
        <text class="feature-text">志愿模拟：输入成绩和志愿，预测各校录取概率</text>
      </view>
      <view class="feature-item">
        <text class="feature-index">02</text>
        <text class="feature-text">志愿推荐：基于模考成绩，生成冲稳保参考方案</text>
      </view>
      <view class="feature-item">
        <text class="feature-index">03</text>
        <text class="feature-text">录取规则：覆盖名额到区、名额到校、统一招生批次</text>
      </view>
    </view>
  </view>

  <tip-section />
</view>
