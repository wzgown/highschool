.about-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.about-logo {
  width: 72rpx;
  height: 72rpx;
}

.about-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.about-desc {
  display: block;
  font-size: 28rpx;
  color: var(--color-text-regular);
  line-height: 1.6;
  margin-bottom: 24rpx;
}

.about-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 20rpx;
  background-color: var(--color-bg);
  border-radius: 8rpx;
}

.about-item {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.5;
}

.feature-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.feature-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.feature-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background-color: var(--color-primary);
  margin-top: 14rpx;
  flex-shrink: 0;
}

.feature-text {
  font-size: 28rpx;
  color: var(--color-text-regular);
  line-height: 1.6;
}
