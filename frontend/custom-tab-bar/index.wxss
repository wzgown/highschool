.tab-bar {
  display: flex;
  background: #ffffff;
  border-top: 1rpx solid #eef1f4;
  padding-bottom: env(safe-area-inset-bottom);
  height: 100rpx;
  box-sizing: content-box;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.tab-icon {
  width: 48rpx;
  height: 48rpx;
}

.tab-text {
  font-size: 20rpx;
  margin-top: 4rpx;
  color: #7c8794;
}

.tab-item-active .tab-text {
  color: #1f7a68;
}
